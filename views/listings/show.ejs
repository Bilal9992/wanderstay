<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-md-6 offset-md-3">

    <!-- Listing Title -->
    <h3 class="mb-4 text-center"><%= listing.title %></h3>

    <!-- Listing Card -->
    <div class="card show-card shadow-sm listing-card">
      <img 
        src="<%= listing.image.url %>" 
        class="card-img-top show-image" 
        alt="<%= listing.title %>"
        style="object-fit: cover; height: 20rem;"
      />
      <div class="card-body">
        <p class="card-text mb-2">
          Owned by <i><%= listing.owner.username %></i>
        </p>
        <p><%= listing.description %></p>
        <p class="card-text mb-1">
          <strong>₹ <%= listing.price.toLocaleString("en-IN") %></strong>
        </p>
        <p class="card-text mb-0">
          <%= listing.location %>, <%= listing.country %>
        </p>
      </div>
    </div>

    <!-- Edit/Delete Buttons -->
    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
      <div class="d-flex mt-3 mb-5">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger me-2">
          Edit
        </a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
          <button type="submit" class="btn btn-dark">Delete</button>
        </form>
      </div>
    <% } %>

    <!-- Review Section -->
    <div class="mt-4">
      <hr />
      <% if(currUser){ %>
        <h4>Leave a Review</h4>
        <form 
          action="/listings/<%= listing._id %>/reviews" 
          method="POST" 
          novalidate 
          class="needs-validation mb-5"
        >
          <!-- Star Rating -->
          <fieldset class="starability-slot mb-3">
            <legend class="form-label">Rating:</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>

            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>

            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>

            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>

            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>

          <!-- Comment Textarea -->
          <div class="mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea 
              name="review[comment]"
              id="comment"
              cols="30"
              rows="5"
              class="form-control"
              required
            ></textarea>
            <div class="invalid-feedback">
              Please submit some comments for review.
            </div>
          </div>

          <!-- Submit Button -->
          <div>
            <button class="btn btn-dark">Submit</button>
          </div>
        </form> 
        <hr />
      <% } %>

      <!-- All Reviews -->
      <p><b>All Reviews</b></p>
      <div class="row">
        <% listing.reviews.forEach(review => { %>
          <div class="card mb-3 col-5 ms-3">
            <div class="card-body">
              <h5 class="card-title"><%= review.author.username %></h5>
              <p class="card-text"><%= review.comment %></p>
              <p class="card-text">Rating: <%= review.rating %> ⭐</p>
            </div>
            <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-sm btn-dark">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- ✅ Google Map at the very end -->
    <div class="map-container mt-5 mb-5">
      <iframe
        src="https://www.google.com/maps/embed?pb=..."
        style="border:0; border-radius:12px; width:100%; height:350px;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>

  </div>
</div>

<!-- Footer -->
<footer class="footer mt-5" style="background:#222; color:#fff; padding:1rem 0; text-align:center;">
  <p>&copy; 2025 My Website</p>
</footer>

<!-- Optional: Ensure map spacing does not overlap footer -->
<style>
.map-container {
  margin-bottom: 50px; /* add extra spacing if needed */
}
</style>
